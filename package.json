{
  "name": "portfolio-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.23.5",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/static-export.test.mjs tests/window-manager.test.mjs",
    "test:browser": "node --test tests/desktop.browser.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-rnd": "10.5.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
